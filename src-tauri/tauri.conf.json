{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bevel Studio",
  "version": "0.1.0",
  "identifier": "com.bevelstudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Bevel Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Bevel Studio",
    "copyright": "© 2026 Bevel Studio contributors",
    "category": "GraphicsAndDesign",
    "shortDescription": "Local-first STL bevel editor",
    "longDescription": "Import a printable STL, select edges, tune a fillet and export a watertight mesh, entirely offline.",
    "homepage": "https://github.com/Quad-Plex/bevel-studio",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
